# Copy to .env. Keep real keys only in the ignored .env file.
ITDESK_CHAT_BASE_URL=https://api.openai.com/v1
ITDESK_CHAT_API_KEY=
ITDESK_CHAT_MODEL=
ITDESK_EMBEDDING_BASE_URL=https://api.openai.com/v1
ITDESK_EMBEDDING_API_KEY=
ITDESK_EMBEDDING_MODEL=
# Optional JSON allowlist of additional model names at the same Embedding endpoint.
ITDESK_EMBEDDING_MODELS=[]
# Optional compatible reranker. Set the API base (for example https://example.com/v1), key and models.
# The backend appends /rerank. The local-lexical option is always available without a remote key.
ITDESK_RERANK_BASE_URL=
ITDESK_RERANK_API_KEY=
ITDESK_RERANK_MODELS=[]
# true explicitly reuses both the Embedding base URL and its API key.
ITDESK_RERANK_USE_EMBEDDING_PROVIDER=false
# Development default; calibrate for your model (cosine distance = 1 - similarity).
ITDESK_MAX_COSINE_DISTANCE=0.50
# Optional USD per million tokens. Empty means unknown.
ITDESK_CHAT_INPUT_PRICE_PER_MILLION=
ITDESK_CHAT_OUTPUT_PRICE_PER_MILLION=
ITDESK_EMBEDDING_PRICE_PER_MILLION=
# Optional Telegram document QA webhook; leave both blank for the normal local demo.
ITDESK_TELEGRAM_WEBHOOK_SECRET=
ITDESK_TELEGRAM_ALLOWED_CHAT_ID=
# JSON array of trusted browser origins. [] disables cross-origin access.
ITDESK_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
